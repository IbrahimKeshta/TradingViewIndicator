//@version=6
// Session Order Flow — context overlay, built in stages.
//
// Stage 1: session boxes, range-used gauge, reference-range sweep state.
// Stage 2: liquidity pools (unswept swing highs / lows) on the chart and a higher timeframe.
// Stage 3: developing volume profile for the current period (POC and value area), plus the
//          prior period's final levels.
// Stage 4: estimated volume delta from lower-timeframe bars (net delta, pressure, flow state).
// Stage 5: conditions verdict (a fixed rule checklist) and the grouped dashboard.
// There are deliberately no entry signals here; this script describes context only.
//
// Nothing here repaints: every classification that is drawn or alerted is decided on a confirmed
// bar close, and no higher-timeframe request.security call is used — the higher-period values (day / week range,
// prior-period high and low) are accumulated locally from chart bars, so history and realtime
// are computed by the same code path. Higher-timeframe swings are likewise built by aggregating
// chart bars locally and are only used once the higher-timeframe bars that confirm them have closed.
//
// The one data request is request.security_lower_tf, which only reads the intrabars inside each
// chart bar. Those feed the volume profile and the delta estimate.
//
// All drawings are anchored by time (xloc.bar_time), not bar index, so no max_bars_back is needed.
indicator("Session Order Flow", shorttitle = "SESS-OF", overlay = true, max_boxes_count = 200, max_lines_count = 100, max_labels_count = 100)

// ============================================================
// INPUTS
// ============================================================

// ---------------- Market mode ----------------
marketMode = input.string("Auto", "Market Mode", options = ["Auto", "24h sessions", "Single session"], group = "Market", tooltip = "24h sessions: Asia / London / New York boxes, and the Asia range is the reference range for the sweep state. Meant for crypto, forex, CFDs and futures.\n\nSingle session: one opening-range box per day, and the prior day's high and low are the reference range. Meant for exchange-hours markets such as EGX.\n\nAuto picks 24h sessions for crypto, forex, CFD and futures symbols and Single session for everything else.")

// ---------------- Sessions (24h mode) ----------------
sessionTimezone = input.string("America/New_York", "Session Timezone", group = "Sessions (24h mode)", tooltip = "The default hours below are quoted in New York time, which lets Pine's DST-aware session matching follow the real opens. Change the hours too if you change this.")
showAsia        = input.bool(true, "Show Asia", group = "Sessions (24h mode)", inline = "asia")
asiaSession     = input.session("1800-0000", "", group = "Sessions (24h mode)", inline = "asia")
showLondon      = input.bool(true, "Show London", group = "Sessions (24h mode)", inline = "ldn")
londonSession   = input.session("0200-0500", "", group = "Sessions (24h mode)", inline = "ldn")
showNewYork     = input.bool(true, "Show New York", group = "Sessions (24h mode)", inline = "ny")
newYorkSession  = input.session("0700-1000", "", group = "Sessions (24h mode)", inline = "ny")

// ---------------- Opening range (single-session mode) ----------------
showOpenRange = input.bool(true, "Show Opening Range", group = "Opening Range (single-session mode)")
openRangeMins = input.int(30, "Opening Range Length (minutes)", minval = 5, maxval = 240, step = 5, group = "Opening Range (single-session mode)", tooltip = "The first N minutes of each trading day. The box is only drawn when the chart timeframe is no larger than this.")

// ---------------- Range used ----------------
avgRangeLen   = input.int(14, "Average Range Length (periods)", minval = 2, maxval = 60, group = "Range Used", tooltip = "Periods are days on an intraday chart, weeks on a daily chart, months on a weekly chart. The average is built from completed periods on the chart, so it needs that many periods of loaded history.")
exhaustedPct  = input.float(85.0, "Exhausted At (% of average range)", minval = 10, step = 5, group = "Range Used")

// ---------------- Liquidity pools ----------------
showPools     = input.bool(true, "Show Chart-Timeframe Pools", group = "Liquidity Pools", tooltip = "BSL (buy-side liquidity) sits above an unswept swing high, SSL (sell-side) below an unswept swing low: where stop orders are likely to be resting.")
pivotLen      = input.int(10, "Swing Length (bars each side)", minval = 2, maxval = 50, group = "Liquidity Pools")
showHtfPools  = input.bool(true, "Show Higher-Timeframe Pools", group = "Liquidity Pools")
htfInput      = input.timeframe("60", "Higher Timeframe", group = "Liquidity Pools", tooltip = "If this is not above the chart timeframe it is bumped automatically: to daily on an intraday chart, weekly on a daily chart, monthly on a weekly chart.")
htfPivotLen   = input.int(3, "HTF Swing Length (HTF bars each side)", minval = 1, maxval = 20, group = "Liquidity Pools")
maxPools      = input.int(5, "Max Pools Kept (per side, per tier)", minval = 1, maxval = 20, group = "Liquidity Pools")
keepTaken     = input.int(3, "Taken Pools Kept (faded)", minval = 0, maxval = 30, group = "Liquidity Pools", tooltip = "How many of the most recently taken pools stay on the chart in grey. 0 removes them as soon as they are taken.\n\nA pool is resolved on the close of the first bar that trades through it: 'swept' if that bar closes back inside, 'run' if it closes beyond.")
poolThickMult = input.float(0.1, "Band Thickness (x ATR)", minval = 0.01, step = 0.05, group = "Liquidity Pools")
colBsl        = input.color(#9c27b0, "BSL", group = "Liquidity Pools", inline = "pcol")
colSsl        = input.color(#3d6fb5, "SSL", group = "Liquidity Pools", inline = "pcol")

// ---------------- Volume profile ----------------
showProfile     = input.bool(true, "Show Developing POC / Value Area", group = "Volume Profile", tooltip = "Built for the current period: the day on an intraday chart, the week on a daily chart. Each chart bar is split into lower-timeframe bars (see Volume Delta settings) and each small bar's volume is spread evenly across the price rows it covers, so the profile reads the same on different chart timeframes wherever that history is available.\n\nPOC (point of control) is the price row with the most volume. The value area is the band around it holding the chosen share of the period's volume.")
showPrevProfile = input.bool(true, "Show Prior Period POC / Value Area", group = "Volume Profile")
vpRows          = input.int(40, "Rows Per Average Range", minval = 10, maxval = 200, group = "Volume Profile", tooltip = "Row height is the average period range divided by this. More rows is finer but noisier.")
vaPct           = input.float(70.0, "Value Area (% of volume)", minval = 10, maxval = 95, step = 5, group = "Volume Profile")
prevKeep        = input.int(2, "Prior-Level Sets Kept On Chart", minval = 1, maxval = 20, group = "Volume Profile", tooltip = "Each new period draws the previous period's POC and value area across it. This is how many of those sets stay visible.")
colPoc          = input.color(#ffeb3b, "POC / Value Area", group = "Volume Profile")

// ---------------- Volume delta ----------------
deltaTfInput = input.string("Auto", "Lower Timeframe (delta and profile)", options = ["Auto", "1", "3", "5", "15", "30", "60", "240"], group = "Volume Delta", tooltip = "The small bars each chart bar is split into. They build the volume profile and the delta estimate.\n\nDelta is an estimate: each lower-timeframe bar's whole volume is counted as buying if it closed up and selling if it closed down. Auto uses 1-minute bars on intraday charts, 30-minute on daily and 4-hour above that.\n\nTradingView only serves a limited depth of lower-timeframe history; older chart bars fall back to the chart bar's own direction. If the choice is not below the chart timeframe, the chart bar's own direction is used throughout.")
pressureLen  = input.int(20, "Pressure Window (bars)", minval = 2, maxval = 200, group = "Volume Delta")
domPct       = input.float(55.0, "Dominance Threshold (% of volume)", minval = 51, maxval = 90, step = 1, group = "Volume Delta", tooltip = "Buying (or selling) share of volume over the pressure window needed to call one side dominant. If one side is dominant but price has not moved its way over the same window, the state reads Absorption instead.")

// ---------------- Conditions ----------------
lowVolRatio = input.float(0.7, "Low-Volume Threshold (x normal)", minval = 0.1, maxval = 1.0, step = 0.05, group = "Conditions", tooltip = "Recent volume (over the pressure window) below this fraction of the longer-run average counts as low participation.")

// ---------------- Display ----------------
labelStyle     = input.string("Auto", "Session Label Style", options = ["Auto", "Full", "Compact"], group = "Display", tooltip = "Full: 'ASIA BULL BREAKOUT'. Compact: 'ASIA ▲'. Auto uses Full in 24h mode and Compact in single-session mode, where boxes are narrow.")
showRefLines   = input.bool(true, "Show Reference High / Low", group = "Display")
showDashboard  = input.bool(true, "Show Dashboard", group = "Display")
dashDetail     = input.string("Full", "Dashboard Detail", options = ["Full", "Compact"], group = "Display", tooltip = "Compact shows only the conditions verdict, its reason, what to look for, and the bias.")
dashTextSize   = input.string("Small", "Dashboard Text Size", options = ["Tiny", "Small", "Normal"], group = "Display")
dashPosition   = input.string("Top right", "Dashboard Position", options = ["Top right", "Top left", "Bottom right", "Bottom left"], group = "Display")
colBull        = input.color(#26c6da, "Bull", group = "Display", inline = "col")
colBear        = input.color(#ff1f5a, "Bear", group = "Display", inline = "col")
colAccum       = input.color(#d4c98a, "Accumulation", group = "Display", inline = "col")
colRef         = input.color(#b0b0b0, "Reference", group = "Display", inline = "col")
boxFillTransp  = input.int(90, "Box Fill Transparency", minval = 50, maxval = 100, group = "Display")

// ============================================================
// MODE RESOLUTION
// ============================================================

autoIs24h    = syminfo.type == "crypto" or syminfo.type == "forex" or syminfo.type == "cfd" or syminfo.type == "futures"
is24hMode    = marketMode == "24h sessions" or (marketMode == "Auto" and autoIs24h)
tfSeconds    = timeframe.in_seconds()
// Session boxes need bars much smaller than the session; on anything above 1h the windows
// stop being resolvable and the script falls back to prior-period context only.
sessionsOn   = is24hMode and timeframe.isintraday and tfSeconds <= 3600
openRangeOn  = not is24hMode and timeframe.isintraday and tfSeconds <= openRangeMins * 60

// The "period" that range-used and the fallback reference range are measured over.
anchorTf     = timeframe.isintraday ? "D" : timeframe.isdaily ? "W" : timeframe.isweekly ? "M" : "12M"
anchorName   = timeframe.isintraday ? "day" : timeframe.isdaily ? "week" : timeframe.isweekly ? "month" : "year"

// ============================================================
// SESSION BOXES
// ============================================================

// state: idle -> forming (inside the window) -> watch (window closed, range frozen)
//        -> bull / bear (first confirmed close outside the frozen range).
// A session that never closes outside its range before its next occurrence stays ACCUMULATION.
type Sess
    string name
    bool   active  = false
    string state   = "idle"
    float  hi      = na
    float  lo      = na
    box    bx      = na
    bool   extend  = false   // keep stretching the box right after the window closes, until the next one opens
    bool   ended   = false   // true only on the first bar after the window
    bool   brokeUp = false   // true only on the bar the breakout is confirmed
    bool   brokeDn = false

labelCompact = labelStyle == "Compact" or (labelStyle == "Auto" and not is24hMode)

method setLook(Sess s, int dir, color c) =>
    if not na(s.bx)
        string status = labelCompact ? (dir > 0 ? " ▲" : dir < 0 ? " ▼" : "") : (dir > 0 ? " BULL BREAKOUT" : dir < 0 ? " BEAR BREAKOUT" : " ACCUMULATION")
        s.bx.set_text(s.name + status)
        s.bx.set_border_color(c)
        s.bx.set_text_color(c)
        s.bx.set_bgcolor(color.new(c, boxFillTransp))
    s

method update(Sess s, bool inSess, bool show) =>
    s.ended   := false
    s.brokeUp := false
    s.brokeDn := false
    if inSess and not s.active
        s.hi    := high
        s.lo    := low
        s.state := "forming"
        s.bx    := show ? box.new(time, high, time_close, low, xloc = xloc.bar_time, border_width = 1, border_style = line.style_dashed, text_size = size.small, text_halign = text.align_left, text_valign = text.align_top) : na
        s.setLook(0, colAccum)
    else if inSess
        s.hi := math.max(s.hi, high)
        s.lo := math.min(s.lo, low)
        if not na(s.bx)
            s.bx.set_top(s.hi)
            s.bx.set_bottom(s.lo)
            s.bx.set_right(time_close)
    if not inSess and s.extend and s.state != "idle" and not na(s.bx)
        s.bx.set_right(time_close)
    if not inSess and s.active
        s.state := "watch"
        s.ended := true
    if not inSess and s.state == "watch" and barstate.isconfirmed
        if close > s.hi
            s.state   := "bull"
            s.brokeUp := true
            s.setLook(1, colBull)
        else if close < s.lo
            s.state   := "bear"
            s.brokeDn := true
            s.setLook(-1, colBear)
    s.active := inSess
    s

inWindow(string sess) => not na(time(timeframe.period, sess, sessionTimezone))

var Sess asia    = Sess.new("ASIA")
var Sess london  = Sess.new("LONDON")
var Sess newYork = Sess.new("NEW YORK")
// The opening range is one or two bars wide, so its box runs to the end of the day instead.
var Sess openRng = Sess.new(name = "OR", extend = true)

newDay = timeframe.change("D")
var int dayOpenTime = na
if newDay or na(dayOpenTime)
    dayOpenTime := time

// Windows are evaluated on every bar, outside any short-circuited expression.
inAsia      = inWindow(asiaSession)
inLondon    = inWindow(londonSession)
inNewYork   = inWindow(newYorkSession)
inOpenRange = time - dayOpenTime < openRangeMins * 60000

// Asia is always tracked in 24h mode, even when hidden, because it is the reference range.
asia.update(sessionsOn and inAsia, showAsia)
london.update(sessionsOn and showLondon and inLondon, true)
newYork.update(sessionsOn and showNewYork and inNewYork, true)
openRng.update(openRangeOn and showOpenRange and inOpenRange, true)

anyBullBreak = asia.brokeUp or london.brokeUp or newYork.brokeUp or openRng.brokeUp
anyBearBreak = asia.brokeDn or london.brokeDn or newYork.brokeDn or openRng.brokeDn

// ============================================================
// RANGE USED  (today's range vs. the average of completed periods)
// ============================================================

newAnchor = timeframe.change(anchorTf)

var float        curHi      = na
var float        curLo      = na
var float        prevHi     = na
var float        prevLo     = na
var int          periods    = 0     // completed-or-started periods seen; the first is partial and is never averaged
var array<float> pastRanges = array.new<float>()

if na(curHi)
    curHi := high
    curLo := low
else if newAnchor
    if periods > 0
        pastRanges.push(curHi - curLo)
        if pastRanges.size() > avgRangeLen
            pastRanges.shift()
        prevHi := curHi
        prevLo := curLo
    periods += 1
    curHi := high
    curLo := low
else
    curHi := math.max(curHi, high)
    curLo := math.min(curLo, low)

avgRangeReady = pastRanges.size() >= math.min(avgRangeLen, 5)
avgRange      = avgRangeReady ? pastRanges.avg() : na
rangeUsedPct  = avgRange > 0 ? (curHi - curLo) / avgRange * 100 : na
rangeExhausted = not na(rangeUsedPct) and rangeUsedPct >= exhaustedPct

// ============================================================
// REFERENCE RANGE AND SWEEP STATE
// ============================================================
// 24h mode with session boxes available: the Asia range, once Asia has closed.
// Otherwise: the prior period's high and low (prior day intraday, prior week on daily, ...).
//
// Per side:  Intact  — never traded beyond
//            Swept   — traded beyond, currently closed back inside (stops taken, move rejected)
//            Broken  — traded beyond and currently closing beyond (move accepted)

var float  refHi      = na
var float  refLo      = na
var bool   hiTouched  = false
var bool   loTouched  = false
var line   refHiLine  = na
var line   refLoLine  = na
refName = sessionsOn ? "Asia" : "Prior " + anchorName

bool refReset  = false
float newRefHi = na
float newRefLo = na
if sessionsOn
    if asia.active
        refHi := na
        refLo := na
        refHiLine.delete()
        refLoLine.delete()
    else if asia.ended
        refReset := true
        newRefHi := asia.hi
        newRefLo := asia.lo
else if newAnchor and not na(prevHi)
    refReset := true
    newRefHi := prevHi
    newRefLo := prevLo

if refReset
    refHi     := newRefHi
    refLo     := newRefLo
    hiTouched := false
    loTouched := false
    // Only the live reference pair is drawn; earlier pairs are removed to keep the chart readable.
    refHiLine.delete()
    refLoLine.delete()
    refHiLine := na
    refLoLine := na
    if showRefLines
        refHiLine := line.new(time, refHi, time_close, refHi, xloc = xloc.bar_time, color = colRef, style = line.style_dotted)
        refLoLine := line.new(time, refLo, time_close, refLo, xloc = xloc.bar_time, color = colRef, style = line.style_dotted)
else if not na(refHi) and not na(refHiLine)
    refHiLine.set_x2(time_close)
    refLoLine.set_x2(time_close)

hiTouchedNow = not na(refHi) and high > refHi
loTouchedNow = not na(refLo) and low < refLo
// A sweep event: first trade beyond the level on a bar that closes back inside it.
hiSweepEvent = barstate.isconfirmed and hiTouchedNow and not hiTouched and close <= refHi
loSweepEvent = barstate.isconfirmed and loTouchedNow and not loTouched and close >= refLo
if hiTouchedNow
    hiTouched := true
if loTouchedNow
    loTouched := true

sideStatus(float level, bool touched, bool beyond) =>
    na(level) ? "Forming" : not touched ? "Intact" : beyond ? "Broken" : "Swept"

hiStatus = sideStatus(refHi, hiTouched, close > refHi)
loStatus = sideStatus(refLo, loTouched, close < refLo)

// ============================================================
// LIQUIDITY POOLS
// ============================================================
// A pool is an unswept swing high (BSL) or swing low (SSL). It lives until the first bar that
// trades through it, and is resolved on that bar's close:
//   swept — closed back inside (stops taken, move rejected)
//   run   — closed beyond (move accepted)

htfBumped = timeframe.isintraday ? "D" : timeframe.isdaily ? "W" : "M"
htfTf     = timeframe.in_seconds(htfInput) > tfSeconds ? htfInput : htfBumped
htfSecs   = timeframe.in_seconds(htfTf)
htfOn     = showHtfPools and htfSecs > tfSeconds
htfLabel  = htfSecs < 3600 ? str.tostring(htfSecs / 60) + "m" : htfSecs < 86400 ? str.tostring(htfSecs / 3600) + "h" : htfTf

atrValue  = nz(ta.atr(14), high - low)
poolThick = math.max(atrValue * poolThickMult, syminfo.mintick)

type Pool
    float level
    bool  isHigh
    bool  htf
    box   bx

poolText(bool isHigh, bool htf) =>
    (htf ? "HTF " : "") + (isHigh ? "BSL" : "SSL") + (htf ? " [" + htfLabel + "]" : "")

poolBox(float level, int t0, bool isHigh, bool htf) =>
    color c  = isHigh ? colBsl : colSsl
    float th = poolThick * (htf ? 2 : 1)
    bool vis = htf ? showHtfPools : showPools
    box b    = na
    if vis
        b := box.new(t0, isHigh ? level : level + th, time_close, isHigh ? level - th : level, xloc = xloc.bar_time, border_color = color.new(c, 100), bgcolor = color.new(c, htf ? 35 : 60), text = poolText(isHigh, htf), text_color = color.new(color.white, 15), text_size = size.tiny, text_halign = text.align_right, text_valign = text.align_center)
    b

// Adds a pool. A higher-timeframe swing at the same price as an existing chart-timeframe pool
// upgrades that pool instead of stacking a second band on top of it.
addPool(array<Pool> arr, float level, int t0, bool isHigh, bool htf) =>
    int same = -1
    if arr.size() > 0
        for i = 0 to arr.size() - 1
            Pool q = arr.get(i)
            if q.isHigh == isHigh and math.abs(q.level - level) <= syminfo.mintick
                same := i
    if same >= 0
        Pool q = arr.get(same)
        if htf and not q.htf
            q.bx.delete()
            q.htf := true
            q.bx  := poolBox(level, t0, isHigh, true)
    else
        arr.push(Pool.new(level, isHigh, htf, poolBox(level, t0, isHigh, htf)))
        int count = 0
        int oldest = -1
        for i = 0 to arr.size() - 1
            Pool q = arr.get(i)
            if q.isHigh == isHigh and q.htf == htf
                count += 1
                if oldest < 0
                    oldest := i
        if count > maxPools
            Pool gone = arr.remove(oldest)
            gone.bx.delete()
    same

var array<Pool> pools = array.new<Pool>()

// ---- chart-timeframe swings ----
pivHi = ta.pivothigh(high, pivotLen, pivotLen)
pivLo = ta.pivotlow(low, pivotLen, pivotLen)
if not na(pivHi)
    addPool(pools, pivHi, time[pivotLen], true, false)
if not na(pivLo)
    addPool(pools, pivLo, time[pivotLen], false, false)

// ---- higher-timeframe swings, aggregated locally from chart bars ----
htfNew = timeframe.change(htfTf)
var float        aggHi = na
var float        aggLo = na
var int          aggT  = na
var array<float> hHi   = array.new<float>()
var array<float> hLo   = array.new<float>()
var array<int>   hT    = array.new<int>()
htfWindow = 2 * htfPivotLen + 1

if htfOn
    if htfNew and not na(aggHi)
        // The higher-timeframe bar that just ended is now final: store it and test the middle
        // bar of the window, which now has htfPivotLen closed bars on each side.
        hHi.push(aggHi)
        hLo.push(aggLo)
        hT.push(aggT)
        if hHi.size() > htfWindow
            hHi.shift()
            hLo.shift()
            hT.shift()
        if hHi.size() == htfWindow
            float midHi = hHi.get(htfPivotLen)
            float midLo = hLo.get(htfPivotLen)
            if midHi == hHi.max() and hHi.indexof(midHi) == htfPivotLen and hHi.lastindexof(midHi) == htfPivotLen
                addPool(pools, midHi, hT.get(htfPivotLen), true, true)
            if midLo == hLo.min() and hLo.indexof(midLo) == htfPivotLen and hLo.lastindexof(midLo) == htfPivotLen
                addPool(pools, midLo, hT.get(htfPivotLen), false, true)
    if htfNew or na(aggHi)
        aggHi := high
        aggLo := low
        aggT  := time
    else
        aggHi := math.max(aggHi, high)
        aggLo := math.min(aggLo, low)

// ---- resolve pools traded through on this bar ----
bool bslSwept = false
bool sslSwept = false
bool bslRun   = false
bool sslRun   = false
var array<box> takenBoxes = array.new<box>()
var string lastLiqText = "none yet"
var int    lastLiqBar  = na

if pools.size() > 0
    for i = pools.size() - 1 to 0
        Pool p = pools.get(i)
        bool hit = p.isHigh ? high > p.level : low < p.level
        if hit and barstate.isconfirmed
            bool accepted = p.isHigh ? close > p.level : close < p.level
            if p.isHigh
                bslRun   := bslRun or accepted
                bslSwept := bslSwept or not accepted
            else
                sslRun   := sslRun or accepted
                sslSwept := sslSwept or not accepted
            string what = poolText(p.isHigh, p.htf) + (accepted ? " run" : " swept")
            lastLiqText := what + " @ " + str.tostring(p.level, format.mintick)
            lastLiqBar  := bar_index
            p.bx.set_right(time_close)
            p.bx.set_bgcolor(color.new(color.gray, 82))
            p.bx.set_text_color(color.new(color.gray, 30))
            p.bx.set_text(what)
            takenBoxes.push(p.bx)
            pools.remove(i)
        else
            p.bx.set_right(time_close)

while takenBoxes.size() > keepTaken
    box old = takenBoxes.shift()
    old.delete()

// Nearest live pool on each side of price, for the dashboard.
float nearBsl = na
float nearSsl = na
if barstate.islast and pools.size() > 0
    for i = 0 to pools.size() - 1
        Pool p = pools.get(i)
        if p.isHigh and p.level > close and (na(nearBsl) or p.level < nearBsl)
            nearBsl := p.level
        if not p.isHigh and p.level < close and (na(nearSsl) or p.level > nearSsl)
            nearSsl := p.level

// ============================================================
// VOLUME PROFILE  (developing, per period)
// ============================================================
// Rows sit on a fixed price grid chosen when the period opens, so the profile is only ever added
// to — nothing already plotted is recalculated. The values plotted on each bar are the POC and
// value area as they stood at that bar's close.

var array<float> prof      = array.new<float>()
var int          profBase  = na      // grid row number of prof[0]
var float        profStep  = na      // row height
var float        profTotal = 0.0
var int          pocRow    = na
var float        pocVol    = 0.0
var float        devPoc    = na
var float        devVah    = na
var float        devVal    = na
var float        prevPoc   = na
var float        prevVah   = na
var float        prevVal   = na
var bool         sawVolume = false

if newAnchor or na(profStep)
    // periods was already advanced above; the period that just ended is complete only if it
    // was not the partial one the chart history starts in.
    if newAnchor and periods > 1 and not na(devPoc)
        prevPoc := devPoc
        prevVah := devVah
        prevVal := devVal
    prof.clear()
    profBase  := na
    profTotal := 0.0
    pocRow    := na
    pocVol    := 0.0
    devPoc    := na
    devVah    := na
    devVal    := na
    // Until enough periods exist for an average range, size rows from ATR; before ATR itself
    // has warmed up, leave the grid undefined so nothing is built on a meaningless row height.
    float basis = not na(avgRange) ? avgRange : bar_index > 20 ? atrValue * 8 : na
    profStep := na(basis) or basis <= 0 ? na : math.max(math.round_to_mintick(basis / vpRows), syminfo.mintick)

// Lower-timeframe bars inside this chart bar. They feed both the profile (so it is built from
// the same small bars whatever the chart timeframe, and reads the same on 5m and 15m) and the
// delta estimate further down. Where TradingView has no intrabar history, the chart bar is used.
ltfTfAuto = timeframe.isintraday ? "1" : timeframe.isdaily ? "30" : "240"
ltfTfWant = deltaTfInput == "Auto" ? ltfTfAuto : deltaTfInput
ltfTf     = timeframe.in_seconds(ltfTfWant) < tfSeconds ? ltfTfWant : timeframe.period
[ltfHi, ltfLo, ltfVol, ltfDeltas] = request.security_lower_tf(syminfo.tickerid, ltfTf, [high, low, volume, close > open ? volume : close < open ? -volume : 0.0])

barVol = nz(volume)
useLtf = ltfVol.size() > 0 and nz(ltfVol.sum()) > 0
if barVol > 0 and not na(profStep)
    sawVolume := true
    int pieces = useLtf ? ltfVol.size() : 1
    for j = 0 to pieces - 1
        float pHi = useLtf ? ltfHi.get(j) : high
        float pLo = useLtf ? ltfLo.get(j) : low
        float pV  = useLtf ? nz(ltfVol.get(j)) : barVol
        if pV > 0 and not na(pHi) and not na(pLo)
            int loRow = int(math.floor(pLo / profStep))
            int hiRow = int(math.floor(pHi / profStep))
            if hiRow - loRow > 2000
                // A freak bar: do not grow the grid for it, credit its close instead.
                loRow := int(math.floor(close / profStep))
                hiRow := loRow
            if na(profBase)
                profBase := loRow
            // Hard ceiling on grid size: a bar that would stretch it past this is credited to
            // the nearest existing edge row rather than growing the array without bound.
            loRow := math.max(loRow, profBase + prof.size() - 5000)
            hiRow := math.min(hiRow, profBase + 4999)
            if hiRow < loRow
                hiRow := loRow
            while loRow < profBase
                prof.unshift(0.0)
                profBase -= 1
            while hiRow > profBase + prof.size() - 1
                prof.push(0.0)
            float share = pV / (hiRow - loRow + 1)
            for r = loRow to hiRow
                float nv = prof.get(r - profBase) + share
                prof.set(r - profBase, nv)
                if nv > pocVol
                    pocVol := nv
                    pocRow := r
            profTotal += pV

    if not na(pocRow)
        // Value area: grow outwards from the POC row, always taking the larger neighbour.
        int n   = prof.size()
        int vLo = pocRow - profBase
        int vHi = vLo
        float acc    = prof.get(vLo)
        float target = profTotal * vaPct / 100
        while acc < target and (vLo > 0 or vHi < n - 1)
            float up = vHi < n - 1 ? prof.get(vHi + 1) : -1.0
            float dn = vLo > 0 ? prof.get(vLo - 1) : -1.0
            if up >= dn
                vHi += 1
                acc += up
            else
                vLo -= 1
                acc += dn
        devPoc := (pocRow + 0.5) * profStep
        devVah := (profBase + vHi + 1) * profStep
        devVal := (profBase + vLo) * profStep

// Drawn as flat lines rather than as a plotted path. The developing lines span the current
// period at their latest values and are removed when the period ends, because a finished
// period's final levels were not known while it was trading. The prior-period lines are fixed
// from the first bar of the period they are drawn across, so those are left on the chart.
var line lPoc  = na
var line lVah  = na
var line lVal  = na
var line lpPoc = na
var line lpVah = na
var line lpVal = na
var int  periodStartT = na
var array<line> prevLines = array.new<line>()

if newAnchor or na(periodStartT)
    periodStartT := time
    lPoc.delete()
    lVah.delete()
    lVal.delete()
    lPoc  := na
    lVah  := na
    lVal  := na
    lpPoc := na
    lpVah := na
    lpVal := na
    if showPrevProfile and not na(prevPoc)
        lpPoc := line.new(time, prevPoc, time_close, prevPoc, xloc = xloc.bar_time, color = color.new(colPoc, 45))
        lpVah := line.new(time, prevVah, time_close, prevVah, xloc = xloc.bar_time, color = color.new(colPoc, 55), style = line.style_dotted)
        lpVal := line.new(time, prevVal, time_close, prevVal, xloc = xloc.bar_time, color = color.new(colPoc, 55), style = line.style_dotted)
        prevLines.push(lpPoc)
        prevLines.push(lpVah)
        prevLines.push(lpVal)
        while prevLines.size() > prevKeep * 3
            line oldLn = prevLines.shift()
            oldLn.delete()
else if not na(lpPoc)
    lpPoc.set_x2(time_close)
    lpVah.set_x2(time_close)
    lpVal.set_x2(time_close)

if showProfile and not na(devPoc)
    if na(lPoc)
        lPoc := line.new(periodStartT, devPoc, time_close, devPoc, xloc = xloc.bar_time, color = colPoc, width = 2)
        lVah := line.new(periodStartT, devVah, time_close, devVah, xloc = xloc.bar_time, color = color.new(colPoc, 20), style = line.style_dashed)
        lVal := line.new(periodStartT, devVal, time_close, devVal, xloc = xloc.bar_time, color = color.new(colPoc, 20), style = line.style_dashed)
    lPoc.set_xy1(periodStartT, devPoc)
    lPoc.set_xy2(time_close, devPoc)
    lVah.set_xy1(periodStartT, devVah)
    lVah.set_xy2(time_close, devVah)
    lVal.set_xy1(periodStartT, devVal)
    lVal.set_xy2(time_close, devVal)

// Small tags at the right-hand end of each line, rebuilt on the last bar only.
var array<label> vpTags = array.new<label>()
vpTag(float y, string txt, color c) =>
    label.new(time_close, y, txt, xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.black, 100), textcolor = c, size = size.tiny)

if barstate.islast
    while vpTags.size() > 0
        label gone = vpTags.pop()
        gone.delete()
    if showProfile and not na(devPoc)
        vpTags.push(vpTag(devPoc, "POC", colPoc))
        vpTags.push(vpTag(devVah, "VAH", colPoc))
        vpTags.push(vpTag(devVal, "VAL", colPoc))
    if showPrevProfile and not na(lpPoc)
        vpTags.push(vpTag(prevPoc, "prior POC", color.new(colPoc, 35)))
        vpTags.push(vpTag(prevVah, "prior VAH", color.new(colPoc, 35)))
        vpTags.push(vpTag(prevVal, "prior VAL", color.new(colPoc, 35)))

// The per-bar values stay available in the Data Window (and to alerts) without drawing a path.
plot(devPoc, "POC", color = colPoc, display = display.data_window)
plot(devVah, "Value Area High", color = colPoc, display = display.data_window)
plot(devVal, "Value Area Low", color = colPoc, display = display.data_window)
plot(prevPoc, "Prior POC", color = colPoc, display = display.data_window)

valuePos = na(devPoc) ? 0 : close > devVah ? 1 : close < devVal ? -1 : 0

// ============================================================
// VOLUME DELTA  (estimated)
// ============================================================
// There is no true bid/ask data in Pine. This splits each chart bar into lower-timeframe bars
// and signs each one's volume by its direction, which is the usual approximation. On forex and
// CFD symbols the underlying figure is tick volume, so treat the result as activity, not size.

barDeltaFallback = close > open ? barVol : close < open ? -barVol : 0.0
barDelta  = ltfDeltas.size() > 0 ? nz(ltfDeltas.sum()) : barDeltaFallback

var float cumDelta = 0.0
if newAnchor
    cumDelta := 0.0
cumDelta += barDelta

buyVol     = (barVol + barDelta) / 2
sumVolN    = math.sum(barVol, pressureLen)
buyPct     = sumVolN > 0 ? math.sum(buyVol, pressureLen) / sumVolN * 100 : na
priceChgN  = close - close[pressureLen]
buyDom     = buyPct >= domPct
sellDom    = buyPct <= 100 - domPct
// Dominant flow that price has not followed: the other side is taking it without giving ground.
buyAbsorbed  = buyDom and priceChgN <= 0
sellAbsorbed = sellDom and priceChgN >= 0
flowState  = na(buyPct) ? "n/a" : buyAbsorbed ? "Absorption — buying absorbed" : sellAbsorbed ? "Absorption — selling absorbed" : buyDom ? "Buying dominance" : sellDom ? "Selling dominance" : "Balanced"
flowColor  = na(buyPct) ? color.gray : buyAbsorbed or sellAbsorbed ? colAccum : buyDom ? colBull : sellDom ? colBear : color.white
tickVolNote = syminfo.type == "forex" or syminfo.type == "cfd" ? "  (tick volume)" : ""

plot(barDelta, "Bar Delta (est.)", display = display.data_window)
plot(cumDelta, "Net Delta (est.)", display = display.data_window)

// ============================================================
// CONDITIONS  (a fixed rule checklist, evaluated top to bottom)
// ============================================================
// Bias: price against both the developing POC and the prior period's POC.
//   above both -> bullish, below both -> bearish, between them -> neutral.
// Verdict: the first rule that applies wins.
//   AVOID       range for the period is already used up
//   WAIT        no bias / price outside the value area / flow disagrees / volume is thin
//   FAVOURABLE  none of the above
// This describes conditions for trading in the bias direction. It is not an entry signal.

bias = na(devPoc) ? 0 : na(prevPoc) ? (close > devPoc ? 1 : close < devPoc ? -1 : 0) : close > devPoc and close > prevPoc ? 1 : close < devPoc and close < prevPoc ? -1 : 0

// Flow that argues against the bias: the other side dominant and getting its way, or the
// bias side's own pressure being absorbed.
flowAgainst = (bias > 0 and ((sellDom and not sellAbsorbed) or buyAbsorbed)) or (bias < 0 and ((buyDom and not buyAbsorbed) or sellAbsorbed))
volRecent   = ta.sma(barVol, pressureLen)
volNormal   = ta.sma(barVol, pressureLen * 5)
lowVolume   = volNormal > 0 and volRecent < volNormal * lowVolRatio
extended    = (bias > 0 and valuePos > 0) or (bias < 0 and valuePos < 0) or (bias != 0 and valuePos == -bias)

// 2 = favourable, 1 = wait, 0 = avoid
verdict = rangeExhausted ? 0 : bias == 0 or extended or flowAgainst or lowVolume ? 1 : 2
favourableLong  = verdict == 2 and bias > 0
favourableShort = verdict == 2 and bias < 0

// ============================================================
// DASHBOARD
// ============================================================

px(float v) => str.tostring(v, format.mintick)

dashPos  = dashPosition == "Top right" ? position.top_right : dashPosition == "Top left" ? position.top_left : dashPosition == "Bottom right" ? position.bottom_right : position.bottom_left
dashSize = dashTextSize == "Tiny" ? size.tiny : dashTextSize == "Normal" ? size.normal : size.small
var table dash = table.new(dashPos, 2, 11, bgcolor = color.new(#0d1321, 15), border_width = 1, border_color = color.new(color.gray, 85))

dashRow(int row, string k, string v, color vc) =>
    dash.cell(0, row, k, text_color = color.gray, text_halign = text.align_left, text_size = dashSize)
    dash.cell(1, row, v, text_color = vc, text_halign = text.align_left, text_size = dashSize)

if showDashboard and barstate.islast
    string biasWord = bias > 0 ? "Bullish" : bias < 0 ? "Bearish" : "Neutral"
    color  biasCol  = bias > 0 ? colBull : bias < 0 ? colBear : color.white
    string dirWord  = bias > 0 ? "Longs" : "Shorts"

    // ---- verdict, reason, what to look for ----
    string verdictText = ""
    string whyText     = ""
    string lookText    = ""
    color  verdictCol  = color.white
    if verdict == 0
        verdictText := "AVOID"
        verdictCol  := colBear
        whyText     := str.tostring(rangeUsedPct, "#") + "% of the average " + anchorName + " range is already used"
        lookText    := "Avoid chasing. This resets when a new " + anchorName + " opens."
    else if verdict == 2
        verdictText := "FAVOURABLE — " + (bias > 0 ? "long side" : "short side")
        verdictCol  := biasCol
        whyText     := "Bias and flow agree, price is inside value, range is available"
        float target = bias > 0 ? nearBsl : nearSsl
        lookText    := dirWord + " favoured. " + (na(target) ? "No liquidity pool ahead." : "Next pool " + px(target) + ".") + " Bias fails " + (bias > 0 ? "below" : "above") + " POC " + px(devPoc) + "."
    else
        verdictText := "WAIT"
        verdictCol  := colAccum
        if bias == 0
            whyText  := na(devPoc) ? "No volume profile, so no bias" : "Price is between today's POC and the prior POC"
            lookText := na(devPoc) ? "This symbol reports no volume." : "Wait for price to hold above or below both POCs."
        else if extended
            bool counter = valuePos == -bias
            whyText  := counter ? "Price has left the value area against the bias" : "Price is extended beyond the value area"
            lookText := counter ? "Wait for price to get back inside value (" + px(devVal) + " – " + px(devVah) + ")." : "Wait for a pullback toward " + (bias > 0 ? "VAH " + px(devVah) : "VAL " + px(devVal)) + " or POC " + px(devPoc) + "."
        else if flowAgainst
            whyText  := "Order flow disagrees with the bias (" + flowState + ")"
            lookText := "Wait for flow to turn, or for the absorption to resolve."
        else
            whyText  := "Volume is thin (" + str.tostring(volRecent / volNormal * 100, "#") + "% of normal)"
            lookText := "Wait for participation to return."

    dashRow(0, "Conditions", verdictText, verdictCol)
    dashRow(1, "Why", whyText, color.white)
    dashRow(2, "Look for", lookText, color.white)
    string biasDetail = na(devPoc) ? "" : na(prevPoc) ? "  (vs POC " + px(devPoc) + ")" : "  (POC " + px(devPoc) + ", prior POC " + px(prevPoc) + ")"
    dashRow(3, "Bias", biasWord + biasDetail, biasCol)

    if dashDetail == "Full"
        string rangeText = na(rangeUsedPct) ? "n/a (needs more history)" : str.tostring(rangeUsedPct, "#") + "% of avg " + anchorName + (rangeExhausted ? "  [EXHAUSTED]" : "")
        dashRow(4, "Range used", rangeText, rangeExhausted ? colBear : color.white)

        string refText = "High " + hiStatus + (na(refHi) ? "" : " @ " + px(refHi)) + "  ·  Low " + loStatus + (na(refLo) ? "" : " @ " + px(refLo))
        dashRow(5, refName + " range", refText, hiStatus == "Swept" or loStatus == "Swept" ? colAccum : color.white)

        string vaText = na(devPoc) ? (sawVolume ? "n/a" : "n/a (no volume on this symbol)") : (valuePos > 0 ? "Above value" : valuePos < 0 ? "Below value" : "Inside value") + "  (" + px(devVal) + " – " + px(devVah) + ")"
        dashRow(6, "Value area", vaText, valuePos > 0 ? colBull : valuePos < 0 ? colBear : color.white)

        string bslText = na(nearBsl) ? "BSL none above" : "BSL " + px(nearBsl) + " (" + str.tostring((nearBsl - close) / atrValue, "#.#") + " ATR)"
        string sslText = na(nearSsl) ? "SSL none below" : "SSL " + px(nearSsl) + " (" + str.tostring((close - nearSsl) / atrValue, "#.#") + " ATR)"
        dashRow(7, "Liquidity", bslText + "  ·  " + sslText, color.white)
        dashRow(8, "Last taken", lastLiqText + (na(lastLiqBar) ? "" : "  (" + str.tostring(bar_index - lastLiqBar) + " bars ago)"), color.white)

        string flowText = not sawVolume ? "n/a (no volume on this symbol)" : flowState + "  ·  " + (na(buyPct) ? "" : str.tostring(buyPct, "#") + "% buy  ·  ") + "net Δ " + (cumDelta >= 0 ? "+" : "") + str.tostring(cumDelta, format.volume) + tickVolNote
        dashRow(9, "Flow (est.)", flowText, flowColor)

        string modeText = is24hMode ? (sessionsOn ? "24h sessions" : "24h, no session boxes on this timeframe") : (openRangeOn ? "Single session" : "Single session, no opening-range box on this timeframe")
        dashRow(10, "Mode", modeText, color.gray)

// ============================================================
// ALERTS
// ============================================================

alertcondition(anyBullBreak, title = "Session Bull Breakout", message = "A session range closed out to the upside on {{ticker}} {{interval}}.")
alertcondition(anyBearBreak, title = "Session Bear Breakout", message = "A session range closed out to the downside on {{ticker}} {{interval}}.")
alertcondition(hiSweepEvent, title = "Reference High Swept", message = "Reference high was taken and price closed back below it on {{ticker}} {{interval}}.")
alertcondition(loSweepEvent, title = "Reference Low Swept", message = "Reference low was taken and price closed back above it on {{ticker}} {{interval}}.")
alertcondition(rangeExhausted and not rangeExhausted[1], title = "Range Exhausted", message = "Average range used has crossed the exhaustion threshold on {{ticker}} {{interval}}.")
alertcondition(bslSwept, title = "BSL Swept", message = "Buy-side liquidity was taken and price closed back below it on {{ticker}} {{interval}}.")
alertcondition(sslSwept, title = "SSL Swept", message = "Sell-side liquidity was taken and price closed back above it on {{ticker}} {{interval}}.")
alertcondition(bslRun, title = "BSL Run", message = "Price closed above a buy-side liquidity pool on {{ticker}} {{interval}}.")
alertcondition(sslRun, title = "SSL Run", message = "Price closed below a sell-side liquidity pool on {{ticker}} {{interval}}.")
alertcondition(buyAbsorbed and not buyAbsorbed[1], title = "Buying Absorbed", message = "Buying is dominant but price has not risen over the pressure window on {{ticker}} {{interval}}.")
alertcondition(sellAbsorbed and not sellAbsorbed[1], title = "Selling Absorbed", message = "Selling is dominant but price has not fallen over the pressure window on {{ticker}} {{interval}}.")
alertcondition(favourableLong and not favourableLong[1], title = "Conditions Favourable (long side)", message = "Conditions turned favourable for the long side on {{ticker}} {{interval}}. This is context, not an entry signal.")
alertcondition(favourableShort and not favourableShort[1], title = "Conditions Favourable (short side)", message = "Conditions turned favourable for the short side on {{ticker}} {{interval}}. This is context, not an entry signal.")

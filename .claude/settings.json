{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/require-docs-sync.sh\"",
            "timeout": 10,
            "statusMessage": "Checking docs-sync before PR"
          }
        ]
      }
    ]
  }
}
